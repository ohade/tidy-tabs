{
  "manifest_version": 3,
  "name": "Tidy Tabs",
  "version": "0.2.0",
  "description": "One-click AI tab organization using local Ollama",
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": ["http://localhost:11434/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Tidy Tabs — click to organize"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
